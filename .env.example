# Example Environment Configuration for Factory Shop-Floor System
# Copy this file to .env for local overrides (never commit real .env to git)

# Flask Environment Mode: 'development' or 'production'
FLASK_ENV=development

# Flask Secret Key for sessions and CSRF
# For local demo, a default fallback is provided in config.py.
# In production, generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-to-a-secure-random-token

# Persistent Database File Path (Absolute or relative to project root)
# Default is 'factory.db' in the project directory
DATABASE_PATH=factory.db

# Downtime Cost Hourly Rate (Case 47 parameter: Rs. 50,000/hr)
DOWNTIME_HOURLY_RATE=50000.0

# Server Listening Port & Host
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
